generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── Finance models ───────────────────────────────────────────────────────────

model Account {
  id              String    @id @default(cuid())
  userId          String    @default("default")
  name            String
  type            String    // "personal" | "company"
  currency        String    // "RSD" | "EUR"
  startingBalance Float     @default(0)
  manualOverride  Float?
  overrideDate    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  incomeEntries   IncomeEntry[]
  expenseEntries  ExpenseEntry[]
  conversionsFrom Conversion[]  @relation("ConvFromAccount")
  conversionsTo   Conversion[]  @relation("ConvToAccount")
  transfersFrom   Transfer[]    @relation("TrfFromAccount")
  transfersTo     Transfer[]    @relation("TrfToAccount")
}

model IncomeEntry {
  id          String   @id @default(cuid())
  userId      String   @default("default")
  date        DateTime
  type        String   // "Salary" | "Invoice" | "Other"
  currency    String
  grossAmount Float
  deduction   Float    @default(0)
  netAmount   Float
  client      String?
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
}

model ExpenseEntry {
  id             String    @id @default(cuid())
  userId         String    @default("default")
  date           DateTime
  type           String    // "personal" | "business"
  category       String
  subcategory    String?
  description    String?
  amount         Float
  currency       String
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id])
  amountRSD      Float
  vatReclaimable Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  merchantName   String?
  merchantPib    String?
  sufUrl         String?
  pdfUrl         String?
  photoUrl       String?
  hasWarranty    Boolean   @default(false)
  warrantyMonths Int?
  warrantyNotes  String?
  tags           String[]  @default([])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  @@index([merchantPib])
  @@index([subscriptionId])
  @@index([date])
}

model Conversion {
  id             String   @id @default(cuid())
  userId         String   @default("default")
  date           DateTime
  amountSent     Float
  fromAccountId  String
  fromAccount    Account  @relation("ConvFromAccount", fields: [fromAccountId], references: [id])
  amountReceived Float
  toAccountId    String
  toAccount      Account  @relation("ConvToAccount", fields: [toAccountId], references: [id])
  rateUsed       Float
  notes          String?
  createdAt      DateTime @default(now())
}

model Transfer {
  id             String   @id @default(cuid())
  userId         String   @default("default")
  date           DateTime
  amountSent     Float
  fromAccountId  String
  fromAccount    Account  @relation("TrfFromAccount", fields: [fromAccountId], references: [id])
  amountReceived Float
  toAccountId    String
  toAccount      Account  @relation("TrfToAccount", fields: [toAccountId], references: [id])
  rateUsed       Float
  notes          String?
  createdAt      DateTime @default(now())
}

model Category {
  id            String   @id @default(cuid())
  userId        String   @default("default")
  name          String
  type          String
  subcategories String[]
  createdAt     DateTime @default(now())
  @@unique([userId, name, type])
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String   @default("default")
  name            String
  billingAmount   Float
  billingCurrency String
  category        String?
  subcategory     String?
  accountId       String?
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expenseEntries  ExpenseEntry[]
}

model Bill {
  id          String   @id @default(cuid())
  userId      String   @default("default")
  name        String
  amount      Float
  currency    String
  category    String?
  subcategory String?
  accountId   String?
  dayOfMonth  Int
  active      Boolean  @default(true)
  notes       String?
  type        String    @default("personal") // "personal" | "company"
  isLoan      Boolean   @default(false)
  lender      String?
  loanEndDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt
  payments    BillPayment[]
}

model BillPayment {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  paidDate  DateTime @default(now())
  amount    Float
  expenseId String?
  createdAt DateTime @default(now())
}

model PurchaseItem {
  id        String    @id @default(cuid())
  userId    String    @default("default")
  name      String
  price     Float?
  currency  String    @default("EUR")
  priority  String    @default("medium") // "high" | "medium" | "low"
  category  String?
  notes     String?
  url       String?
  bought    Boolean   @default(false)
  boughtAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CryptoHolding {
  id        String   @id @default(cuid())
  userId    String   @default("default")
  symbol    String
  quantity  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id        String   @id @default(cuid())
  userId    String   @default("default")
  category  String
  amountRSD Float?
  amountEUR Float?
  period    String   @default("month")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavingGoal {
  id           String          @id @default(cuid())
  userId       String          @default("default")
  name         String
  targetAmount Float
  currency     String
  accountId    String?
  targetDate   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deposits     SavingDeposit[]
}

model SavingDeposit {
  id        String     @id @default(cuid())
  goalId    String
  goal      SavingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String
  date      DateTime   @default(now())
  notes     String?
  createdAt DateTime   @default(now())
}

// ─── Life / Habit models ──────────────────────────────────────────────────────

model Habit {
  id            String         @id @default(cuid())
  name          String
  category      String
  type          String
  unit          String?
  target        Float?
  frequency     String
  frequencyDays Int[]
  icon          String?
  color         String?
  timeOfDay     String         @default("all_day")
  order         Int            @default(0)
  active        Boolean        @default(true)
  paused        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  logs          HabitLog[]
  subTasks      HabitSubTask[]
}

model HabitSubTask {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  name    String
  order   Int    @default(0)
}

model HabitLog {
  id                  String   @id @default(cuid())
  habitId             String
  habit               Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date                DateTime
  completed           Boolean  @default(false)
  value               Float?
  notes               String?
  completedSubTaskIds String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@unique([habitId, date])
}

model BodyMetric {
  id        String   @id @default(cuid())
  date      DateTime
  metric    String   // "weight" | "waist" | "chest" | "bicep" | "shoulders" | "thigh"
  value     Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([date, metric])
  @@index([metric, date])
}

model ScheduleBlock {
  id           String   @id @default(cuid())
  day          String
  startTime    String
  endTime      String?
  name         String
  note         String?
  category     String
  sacred       Boolean  @default(false)
  frequency    String   @default("weekly") // "weekly" | "biweekly"
  biweeklyRef  Int?     // ISO week number % 2 when block was configured
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ScheduleDay {
  id      String  @id @default(cuid())
  day     String  @unique
  label   String?
  summary String?
}

// ─── Food module ─────────────────────────────────────────────────────────────

model Place {
  id            String    @id @default(cuid())
  name          String
  city          String
  country       String    @default("")
  cuisine       String    @default("")
  category      String    // "been" | "want_to_go" | "regular"
  myRating      Float?
  notes         String?
  mustOrder     String?
  priceRange    String?   // "budget" | "mid" | "upscale"
  latitude      Float
  longitude     Float
  address       String?
  visitedAt     DateTime?
  googlePlaceId String?
  photoUrl      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Life — Goals, Contacts, Journal, Calendars ──────────────────────────────

model Goal {
  id         String          @id @default(cuid())
  name       String
  emoji      String?
  color      String?
  targetDate DateTime?
  completed  Boolean         @default(false)
  type       String          @default("long_term")
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  milestones GoalMilestone[]
}

model GoalMilestone {
  id        String  @id @default(cuid())
  goalId    String
  goal      Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  name      String
  completed Boolean @default(false)
  order     Int     @default(0)
}

model Contact {
  id                String    @id @default(cuid())
  name              String
  emoji             String?
  color             String?
  birthday          String?
  reachOutFrequency String    @default("monthly")
  lastContactDate   DateTime?
  note              String?
  order             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model JournalQuestion {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)
}

model JournalEntry {
  id        String   @id @default(cuid())
  date      DateTime @unique
  answers   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ICSCalendar {
  id    String @id @default(cuid())
  name  String
  url   String
  color String @default("#6366f1")
  order Int    @default(0)
}

model AppConfig {
  key   String @id
  value String
}

// ─── Watchlist ────────────────────────────────────────────────────────────────

model WatchlistItem {
  id          String    @id @default(cuid())
  userId      String    @default("default")
  type        String    // "movie" | "tv" | "book"
  status      String    // "want_to" | "currently" | "finished" | "loved_it"
  title       String
  externalId  String?   // TMDB numeric ID or Google Books volumeId
  posterUrl   String?   // Full image URL (pre-resolved)
  year        Int?
  genres      String[]  @default([])
  overview    String?
  author      String?   // books only
  tmdbRating  Float?    // TMDB vote_average (0-10)
  streamingOn String[]  @default([]) // provider names for RS, e.g. ["Netflix", "Max"]
  myRating    Int?      // personal 1-10
  notes       String?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([userId, type, status])
}

// ─── Shared ───────────────────────────────────────────────────────────────────

model Settings {
  id           String   @id @default("default")
  userId       String   @default("default") @unique
  manualRate   Float    @default(117.5)
  weekStartsOn Int      @default(1)
  theme        String   @default("light")
  updatedAt    DateTime @updatedAt
}
